# Copy to .env on the Ubuntu host: cp .env.example .env
# Compose reads .env for interpolation and passes the same file into the container.
# IntelliJ does NOT load .env; application*.properties defaults cover local IDE runs.
# Optional: EnvFile plugin, or Run Configuration → Environment variables → enable "Enable EnvFile".

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8443
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=file:/certs/omidashouri.jks
SERVER_SSL_KEY_STORE_PASSWORD=omidashouri
SERVER_SSL_KEY_STORE_TYPE=JKS
SERVER_SSL_KEY_ALIAS=omidashouri
SERVER_SSL_KEY_PASSWORD=omidashouri

# dev:  jdbc:oracle:thin:@//172.17.70.221:1521/dbcntrs.imi.ir
# prod: jdbc:oracle:thin:@//172.17.70.222:1521/dbcntrp.imi.ir
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//172.17.70.221:1521/dbcntrs.imi.ir
SPRING_DATASOURCE_USERNAME=crm
SPRING_DATASOURCE_PASSWORD=imiApplication

SPRING_JACKSON_TIME_ZONE=GMT+3:30

