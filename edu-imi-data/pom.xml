<!-- SabtAhval → -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>${org.codehaus.mojo.jaxb2-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>xjc-schema2</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${basedir}/src/main/resources/xsd</source>
                            </sources>
                            <xjbSources>
                                <xjbSource>${basedir}/src/main/resources/xjb/global.xjb</xjbSource>
                            </xjbSources>
                            <packageName>edu.imi.ir.eduimiws.models.sabtahval</packageName>
                            <addGeneratedAnnotation>true</addGeneratedAnnotation>
                            <!--  Other configuration options-->
                            <clearOutputDir>false</clearOutputDir>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
